+func newProgressReporter(ctx context.Context, output io.Writer, enabled bool) *cliProgressReporter {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if output == nil {
+		output = io.Discard
+	}
+	return &cliProgressReporter{
+		ctx:     ctx,
+		out:     output,
+		enabled: enabled,
+	}
+}
+
+func (r *cliProgressReporter) Err() error {
+	if r == nil || r.ctx == nil {
+		return nil
+	}
+	return r.ctx.Err()
+}
+
+// Send accepts the progress events emitted by lint and pack. Returning the
+// context error lets synchronous callers observe cancellation while existing
+// event call sites can continue to treat reporting as best effort.
+func (r *cliProgressReporter) Send(msg any) error {
+	if r == nil {
+		return nil
+	}
+	if err := r.Err(); err != nil {
+		return err
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	switch msg := msg.(type) {
+	case progressMsg:
+		r.sendPackProgress(msg)
+	case statsMsg:
+		if r.pack != nil {
+			r.pack.apply(msg)
+		}
+	case completedMsg:
+		if r.pack != nil {
+			r.pack.apply(msg)
+			r.writePackSummary()
+		}
+	case errorMsg:
+		if r.pack != nil {
+			r.pack.apply(msg)
+		}
+	case logMsg:
+		if r.pack != nil {
+			r.pack.apply(msg)
+			if r.pack.verbose && len(r.pack.logs) > 0 {
+				r.writeLine(r.pack.logs[len(r.pack.logs)-1])
+			}
 		}
+	case lintEntryMsg:
+		r.lintEntry = msg.entry
+	case lintProgressMsg:
+		r.sendLintProgress(msg)
+	case lintCompleteMsg:
+		r.lintDone = true
+		r.finishProgressLine()
+	case lintErrorMsg:
+		r.finishProgressLine()
+	}
+
+	return r.Err()
+}
+
