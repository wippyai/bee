#!/bin/sh
set -eu
fixture_dir="$(dirname "$0")/../../driver-options"
case "${1:-}" in
  --version) printf '%s\n' 'codex-cli 0.160.1' ;;
  --help) cat "$fixture_dir/codex-0.160.1-help.txt" ;;
  exec)
    case "${2:-}" in
      --help) cat "$fixture_dir/codex-0.160.1-exec-help.txt" ;;
      resume) test "${3:-}" = --help; cat "$fixture_dir/codex-0.160.1-resume-help.txt" ;;
      *) exit 64 ;;
    esac ;;
  *) exit 64 ;;
esac
