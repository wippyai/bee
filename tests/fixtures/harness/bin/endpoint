#!/usr/bin/env python3
# Controlled local endpoint for authentication-path proofs: records the
# authorization and x-api-key headers of every request to the named file
# and answers a 400 invalid_request_error with a fixed body, so no request
# ever succeeds against a provider and no client keeps retrying. An optional
# hold in seconds delays each answer after the request is recorded, which
# gives a proof a window in which the client is provably alive and waiting.
# With BEE_ENDPOINT_TOOL set, a Messages request that offers a Bash tool
# and carries no tool result is answered with a scripted tool_use of that
# command, and every later request with a short text turn, so a harness
# reaches its own permission exchange without any provider. With
# BEE_ENDPOINT_MCP_TOOL set, the first request of either API is answered
# with a scripted call of that tool on the MCP server named bee (a Messages
# tool_use of mcp__bee__<tool>, a Responses function_call of <tool> in the
# mcp__bee namespace) and every later request with a short text turn; the
# record keeps the tool names offered and an excerpt of the tool result,
# which is how a real harness proves a read through the gateway.
import http.server, json, os, sys, time
record = sys.argv[1]
hold = float(sys.argv[2]) if len(sys.argv) > 2 else 0.0
tool_command = os.environ.get("BEE_ENDPOINT_TOOL", "")
mcp_tool = os.environ.get("BEE_ENDPOINT_MCP_TOOL", "")
plain_text = os.environ.get("BEE_ENDPOINT_TEXT", "")
def sse(events):
    return "".join("event: " + name + "\ndata: " + json.dumps(payload) + "\n\n" for name, payload in events).encode()
def message_start(message_id):
    return ("message_start", {"type": "message_start", "message": {"id": message_id, "type": "message", "role": "assistant", "model": "bee-endpoint", "content": [], "stop_reason": None, "stop_sequence": None, "usage": {"input_tokens": 10, "output_tokens": 1}}})
def tool_turn(command):
    return sse([message_start("msg_tool"),
        ("content_block_start", {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "toolu_bee_1", "name": "Bash", "input": {}}}),
        ("content_block_delta", {"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": json.dumps({"command": command, "description": "leave a marker"})}}),
        ("content_block_stop", {"type": "content_block_stop", "index": 0}),
        ("message_delta", {"type": "message_delta", "delta": {"stop_reason": "tool_use", "stop_sequence": None}, "usage": {"output_tokens": 20}}),
        ("message_stop", {"type": "message_stop"})])
def mcp_tool_turn(name, arguments):
    return sse([message_start("msg_mcp"),
        ("content_block_start", {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "toolu_bee_mcp", "name": name, "input": {}}}),
        ("content_block_delta", {"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": json.dumps(arguments)}}),
        ("content_block_stop", {"type": "content_block_stop", "index": 0}),
        ("message_delta", {"type": "message_delta", "delta": {"stop_reason": "tool_use", "stop_sequence": None}, "usage": {"output_tokens": 20}}),
        ("message_stop", {"type": "message_stop"})])
def responses_events(item, response_id):
    return sse([("response.created", {"type": "response.created", "response": {"id": response_id, "object": "response", "status": "in_progress", "output": []}}),
        ("response.output_item.added", {"type": "response.output_item.added", "output_index": 0, "item": item}),
        ("response.output_item.done", {"type": "response.output_item.done", "output_index": 0, "item": item}),
        ("response.completed", {"type": "response.completed", "response": {"id": response_id, "object": "response", "status": "completed", "output": [item], "usage": {"input_tokens": 10, "output_tokens": 5, "total_tokens": 15}}})])
def responses_mcp_call(tool, arguments):
    return responses_events({"type": "function_call", "id": "fc_bee_mcp", "call_id": "call_bee_mcp", "name": tool, "namespace": "mcp__bee", "arguments": json.dumps(arguments), "status": "completed"}, "resp_mcp")
def responses_text(text):
    return responses_events({"type": "message", "id": "msg_done", "role": "assistant", "status": "completed", "content": [{"type": "output_text", "text": text, "annotations": []}]}, "resp_text")
def text_turn(text):
    return sse([message_start("msg_text"),
        ("content_block_start", {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}}),
        ("content_block_delta", {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": text}}),
        ("content_block_stop", {"type": "content_block_stop", "index": 0}),
        ("message_delta", {"type": "message_delta", "delta": {"stop_reason": "end_turn", "stop_sequence": None}, "usage": {"output_tokens": 5}}),
        ("message_stop", {"type": "message_stop"})])
class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *arguments):
        pass
    def do_POST(self):
        length = int(self.headers.get("content-length", "0") or 0)
        body = self.rfile.read(length) if length else b""
        authorization = self.headers.get("authorization", "")
        api_key = self.headers.get("x-api-key", "")
        try:
            parsed = json.loads(body)
        except Exception:
            parsed = {}
        messages = parsed.get("messages") if isinstance(parsed, dict) else None
        messages = messages if isinstance(messages, list) else []
        tools = parsed.get("tools") if isinstance(parsed, dict) else None
        tools = tools if isinstance(tools, list) else []
        offers_bash = any(isinstance(tool, dict) and tool.get("name") == "Bash" for tool in tools)
        responses_api = "/responses" in self.path
        # The names offered for the MCP server named bee: Messages lists them
        # flat, Responses nests them under a namespace tool.
        mcp_tools = []
        for tool in tools:
            if not isinstance(tool, dict):
                continue
            name = tool.get("name") or ""
            if name.startswith("mcp__bee__"):
                mcp_tools.append(name[len("mcp__bee__"):])
            if name == "mcp__bee" and isinstance(tool.get("tools"), list):
                mcp_tools.extend(inner.get("name") for inner in tool["tools"] if isinstance(inner, dict))
        # The tool ran once the conversation carries any tool_result; the
        # harness may append further user messages after it, so the last
        # message alone does not tell.
        has_tool_result = False
        result_excerpt = ""
        for message in messages:
            content = message.get("content") if isinstance(message, dict) else None
            for item in (content if isinstance(content, list) else []):
                if isinstance(item, dict) and item.get("type") == "tool_result":
                    has_tool_result = True
                    blocks = item.get("content")
                    if isinstance(blocks, list):
                        result_excerpt = "".join(block.get("text", "") for block in blocks if isinstance(block, dict))[:400]
                    else:
                        result_excerpt = str(blocks)[:400]
        inputs = parsed.get("input") if isinstance(parsed, dict) else None
        for item in (inputs if isinstance(inputs, list) else []):
            if isinstance(item, dict) and item.get("type") == "function_call_output":
                has_tool_result = True
                result_excerpt = str(item.get("output"))[:400]
        with open(record, "a") as out:
            out.write(json.dumps({"path": self.path, "authorization": authorization, "x_api_key": api_key, "content_type": self.headers.get("content-type", ""), "messages": len(messages), "input_items": len(inputs) if isinstance(inputs, list) else 0, "offers_bash": offers_bash,
                "tool_result": has_tool_result, "mcp_tools": mcp_tools, "result_excerpt": result_excerpt}) + "\n")
        if hold > 0:
            time.sleep(hold)
        if mcp_tool:
            if responses_api:
                payload = responses_text("done") if has_tool_result else responses_mcp_call(mcp_tool, {"cursor": 0})
            else:
                payload = text_turn("done") if has_tool_result else mcp_tool_turn("mcp__bee__" + mcp_tool, {"cursor": 0})
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
        elif plain_text:
            payload = responses_text(plain_text) if responses_api else text_turn(plain_text)
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
        elif tool_command:
            payload = tool_turn(tool_command) if offers_bash and not has_tool_result else text_turn("done")
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
        else:
            payload = json.dumps({"type": "error", "error": {"message": "controlled endpoint", "type": "invalid_request_error"}}).encode()
            self.send_response(400)
            self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)
    do_GET = do_POST
server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
with open(record + ".port", "w") as out:
    out.write(str(server.server_address[1]))
server.serve_forever()
