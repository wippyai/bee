#!/bin/bash
# Codex protocol fixture: replays a captured exec-json-1 stream in place of
# the Codex executable. This is protocol evidence, not the real harness. It
# lives outside bin/ so no bare `codex` lookup in the test composition
# resolves it.
stream="${BEE_FIXTURE_STREAM:?BEE_FIXTURE_STREAM names the captured stream}"
if [ -n "${BEE_FIXTURE_GIT_COMMIT:-}" ]; then
  [ "$BEE_FIXTURE_GIT_COMMIT" = "1" ] || exit 64
  writable_roots=""
  for argument in "$@"; do
    case "$argument" in
      sandbox_workspace_write.writable_roots=*) writable_roots="$argument" ;;
    esac
  done
  [ -n "$writable_roots" ] || { printf '%s\n' 'Codex writable roots were not passed' >&2; exit 65; }
  while IFS= read -r path; do
    case "$writable_roots" in
      *"\"$path\""*) ;;
      *) printf 'Codex writable roots omitted %s\n' "$path" >&2; exit 66 ;;
    esac
  done < <(git -C "$PWD" rev-parse --path-format=absolute --git-dir --git-common-dir)
  if ! git log --all --format=%s | grep -Fxq 'bee fixture commit'; then
    marker=".bee-fixture-commit-$$"
    printf '%s\n' 'committed from a confined Codex fixture' > "$marker"
    git add -- "$marker"
    git commit --quiet -m "bee fixture commit"
  fi
fi
if [ -n "${BEE_FIXTURE_GATEWAY:-}" ]; then
  # Codex reads its gateway from config.toml in its private CODEX_HOME and the
  # bearer credential from the environment variable that file names; the
  # gateway client reads the same two, and reports status codes only on stderr.
  "$(dirname "$0")/../bin/gateway-client" codex "${CODEX_HOME:-$HOME/.codex}/config.toml" >&2
fi
# A trailing hold keeps the child alive after its stream so a caller can register
# a one-shot notice and observe the ending, exactly as the Claude fixture's
# linger does. Unset, the fixture exits immediately.
cat "$stream"
if [ -n "${BEE_FIXTURE_LINGER:-}" ]; then
  sleep "$BEE_FIXTURE_LINGER"
fi
exit "${BEE_FIXTURE_EXIT:-0}"
