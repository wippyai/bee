--- /dev/null
+++ b/api/service/exec/labels_test.go
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: MPL-2.0
+package exec
+
+import "testing"
+
+func TestProcessLabelsAreValidatedAndCopied(t *testing.T) {
+	options := ProcessOptions{Labels: map[string]string{"bee.attempt_id": "attempt-1"}}
+	clone, err := options.Clone()
+	if err != nil {
+		t.Fatal(err)
+	}
+	options.Labels["bee.attempt_id"] = "changed"
+	if clone.Labels["bee.attempt_id"] != "attempt-1" {
+		t.Fatal("retained mutable labels")
+	}
+	for _, labels := range []map[string]string{{"": "bad"}, {"bad\x00": "value"}, {"key": "bad\x00"}} {
+		if _, err := (ProcessOptions{Labels: labels}).Clone(); err == nil {
+			t.Fatal("accepted malformed labels")
+		}
+	}
+}
