# MIT. Minimal host composition for the isolated Hive supervisor proof.
version: '1.0'
namespace: bee
entries:
- name: terminal
  kind: terminal.host
  lifecycle: {auto_start: true, requires: [bee.hive.service:supervisor_host]}
- name: workers
  kind: process.host
  host: {max_processes: 64, workers: 2}
  lifecycle: {auto_start: true}
- name: dependency_sync
  kind: ns.dependency
  component: bee/sync
  version: 0.1.0-dev
  parameters:
  - name: target_sender
    value: bee.hive.service:replica_sender
  - name: target_exports
    value: bee:sync_exports
- name: dependency_threads
  kind: ns.dependency
  component: bee/threads
  version: 0.1.0-dev
  parameters:
  - name: process_host
    value: bee:workers
  - name: waiter_policies
    value: [bee.security.threads:thread_waiter_policy]
- name: dependency_hive_telemetry
  kind: ns.dependency
  component: bee/hive-telemetry
  version: 0.1.0-dev
  parameters:
  - name: target_exposure
    value: bee.security.hive:hive_exposure_policy
- name: sync_exports
  kind: registry.entry
  meta:
    type: bee.sync.exports
  data: {exports: []}
