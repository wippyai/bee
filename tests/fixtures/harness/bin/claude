#!/bin/bash
# Claude protocol fixture: replays a captured stream-json-2 file in place of
# the Claude executable. This is protocol evidence, not the real harness.
# The permission mode answers a control_request from stdin with a timeout,
# which is why this fixture runs under bash.
stream="${BEE_FIXTURE_STREAM:?BEE_FIXTURE_STREAM names the captured stream}"
# Under stream-json input the harness takes its brief as the first user
# line on stdin, as the real executable does; the fixture consumes it.
previous=""
stream_json=""
for argument in "$@"; do
  if [ "$previous" = "--input-format" ] && [ "$argument" = "stream-json" ]; then
    stream_json=1
    read -r brief
    printf '%s\n' "brief:$brief" >&2
  fi
  previous="$argument"
done
if [ -n "${BEE_FIXTURE_READ:-}" ]; then
  read -r line
  printf '%s\n' "read:$line" >&2
fi
if [ -n "${BEE_FIXTURE_HOOKS:-}" ]; then
  # Hook reporter: the child posts hook events the way Claude Code's http
  # hook handler would, to the URL the settings adapter in its home names,
  # with the hook credential from the environment destination, and reports
  # status codes only. BEE_FIXTURE_HOOKS_FLOOD posts that many extra tool
  # events back to back so the queue bound is reached.
  python3 - <<'PY' >&2
import json, os, urllib.request, urllib.error
settings = json.load(open(os.path.join(os.environ["HOME"], ".claude/settings.json")))
url = settings["allowedHttpHookUrls"][0]
token = os.environ.get("BEE_GATEWAY_HOOK_TOKEN", "")
def post(payload):
    request = urllib.request.Request(url, data=json.dumps(payload).encode(), headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.status, response.read().decode()
    except urllib.error.HTTPError as error:
        return error.code, ""
    except Exception as error:
        return 0, str(error)
session = "fixture-session"
events = [
    {"hook_event_name": "SessionStart", "session_id": session, "source": "startup", "cwd": os.getcwd()},
    {"hook_event_name": "UserPromptSubmit", "session_id": session, "prompt_id": "prompt-1", "prompt": "the brief"},
    {"hook_event_name": "PreToolUse", "session_id": session, "prompt_id": "prompt-1", "tool_use_id": "toolu_fixture_1", "tool_name": "Bash", "tool_input": {"command": "true", "secret": "sk-fixture-000"}},
    {"hook_event_name": "PostToolUse", "session_id": session, "prompt_id": "prompt-1", "tool_use_id": "toolu_fixture_1", "tool_name": "Bash", "tool_response": {"stdout": "", "stderr": ""}, "duration_ms": 5, "decision": "block"},
    {"hook_event_name": "Stop", "session_id": session, "prompt_id": "prompt-1", "stop_hook_active": False, "last_assistant_message": "done"},
]
report = {"statuses": [post(event)[0] for event in events], "bodies_empty": True}
for event in events[:1]:
    status, body = post(event)
    report["replay"] = status
    if body != "": report["bodies_empty"] = False
flood = int(os.environ.get("BEE_FIXTURE_HOOKS_FLOOD", "0"))
if flood:
    codes = {}
    for index in range(flood):
        status, _ = post({"hook_event_name": "PostToolUse", "session_id": session, "prompt_id": "prompt-1", "tool_use_id": "toolu_flood_%d" % index, "tool_name": "Bash"})
        codes[str(status)] = codes.get(str(status), 0) + 1
    report["flood"] = codes
print("hooks:" + json.dumps(report, sort_keys=True))
PY
fi
if [ -n "${BEE_FIXTURE_GATEWAY:-}" ]; then
  # Gateway client: the child reads the host-approved MCP configuration from
  # its private home and the bearer token from the environment destination
  # the configuration names, walks initialization, discovery and a call,
  # optionally waits and holds, and reports status codes only on stderr.
  # A revoked gateway can make placement request cooperative shutdown while
  # this client is holding. Flush its last real HTTP check before exiting;
  # the runner's normal forced-stop deadline remains authoritative.
  gateway_stopping=""
  trap 'gateway_stopping=1' TERM
  python3 - <<'PY' >&2
import json, os, signal, threading, time, urllib.request, urllib.error
stopping = threading.Event()
signal.signal(signal.SIGTERM, lambda *_: stopping.set())
config = json.load(open(os.path.join(os.environ["HOME"], ".claude.json")))
server = config["mcpServers"]["bee"]
url = server["url"]
authorization = server["headers"]["Authorization"].replace("${BEE_GATEWAY_TOKEN}", os.environ.get("BEE_GATEWAY_TOKEN", ""))
def rpc(method, params=None, ident=1, timeout=10):
    body = json.dumps({"jsonrpc": "2.0", "id": ident, "method": method, "params": params or {}}).encode()
    request = urllib.request.Request(url, data=body, headers={"Authorization": authorization, "Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, json.loads(response.read())
    except urllib.error.HTTPError as error:
        return error.code, None
    except Exception as error:
        return 0, str(error)
def outcome(reply):
    try:
        return json.loads(reply["result"]["content"][0]["text"])
    except Exception:
        return None
report = {}
status, initialized = rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "bee-fixture", "version": "0"}})
report["initialize"] = status
report["protocol"] = initialized["result"]["protocolVersion"] if status == 200 and initialized else None
status, listed = rpc("tools/list", ident=2)
report["list"] = status
report["tools"] = sorted(tool["name"] for tool in listed["result"]["tools"]) if status == 200 and listed else []
status, read = rpc("tools/call", {"name": "thread_read", "arguments": {"cursor": 0}}, ident=3)
report["read"] = status
value = outcome(read) if status == 200 else None
report["read_ok"] = bool(value and value.get("ok"))
wait_ms = int(os.environ.get("BEE_FIXTURE_GATEWAY_WAIT", "0"))
if wait_ms:
    started = time.time()
    head = int(((value or {}).get("value") or {}).get("scanned_through") or 0)
    # The wait is a wakeup on the head: records the carrier itself commits
    # wake it, so the client waits again past them until it is released or
    # its own budget elapses.
    result = None
    for attempt in range(12):
        status, waited = rpc("tools/call", {"name": "thread_wait", "arguments": {"after_sequence": head, "wait_ms": wait_ms}}, ident=4 + attempt, timeout=wait_ms / 1000 + 10)
        value = outcome(waited) if status == 200 else None
        result = (value or {}).get("value")
        if status != 200 or not isinstance(result, dict) or result.get("status") != "ready":
            break
        head = int(result.get("scanned_through") or head)
    report["wait"] = {"status": status, "elapsed_ms": int((time.time() - started) * 1000), "outcome": result}
hold = float(os.environ.get("BEE_FIXTURE_GATEWAY_HOLD", "0"))
if hold:
    stopping.wait(hold)
    report["after_hold"] = rpc("tools/list", ident=5)[0]
print("gateway:" + json.dumps(report, sort_keys=True))
PY
  trap - TERM
  if [ -n "$gateway_stopping" ]; then exit 143; fi
fi
if [ -n "${BEE_FIXTURE_HUGE:-}" ]; then
  printf '{"type":"system","subtype":"status","padding":"'
  i=0
  while [ "$i" -lt 700 ]; do printf 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'; i=$((i + 1)); done
  printf '"}\n'
fi
if [ -n "${BEE_FIXTURE_PERMISSION:-}" ]; then
  # Interactive permission exchange: the control_request frame is printed,
  # then the fixture waits for a correlated control_response line on stdin.
  # allow continues the captured stream; deny reports the denial and ends;
  # an uncorrelated or malformed line is ignored and the wait continues;
  # silence past the timeout ends with a permission_timeout result.
  id="$BEE_FIXTURE_PERMISSION"
  timeout="${BEE_FIXTURE_PERMISSION_TIMEOUT:-2}"
  # The stream comes in on descriptor 3 so the response is read from stdin.
  while IFS= read -r frame <&3 || [ -n "$frame" ]; do
    printf '%s\n' "$frame"
    case "$frame" in
      *'"type":"control_request"'*)
        decision=""
        while [ -z "$decision" ]; do
          if read -t "$timeout" -r line; then
            case "$line" in
              *"\"request_id\":\"$id\""*)
                case "$line" in
                  *'"behavior":"allow"'*) decision=allow ;;
                  *'"behavior":"deny"'*) decision=deny ;;
                  *) printf '%s\n' "malformed:$line" >&2 ;;
                esac ;;
              *) printf '%s\n' "uncorrelated:$line" >&2 ;;
            esac
          else
            decision=timeout
          fi
        done
        case "$decision" in
          deny)
            printf '{"type":"system","subtype":"permission_denied","tool_name":"Bash","message":"denied by the owner","session_id":"fixture"}\n'
            printf '{"type":"result","subtype":"error_permission","is_error":true,"result":"permission denied","permission_denials":[{"tool_name":"Bash","tool_use_id":"%s"}],"session_id":"fixture"}\n' "$id"
            exit 0 ;;
          timeout)
            printf '{"type":"result","subtype":"error","is_error":true,"terminal_reason":"permission_timeout","result":"no permission response","session_id":"fixture"}\n'
            exit 2 ;;
        esac ;;
    esac
  done 3< "$stream"
elif [ -n "${BEE_FIXTURE_PACE:-}" ]; then
  # One frame at a time with a pause, so a carrier can be replaced mid-stream.
  while IFS= read -r frame || [ -n "$frame" ]; do
    printf '%s\n' "$frame"
    sleep "$BEE_FIXTURE_PACE"
  done < "$stream"
elif [ -n "${BEE_FIXTURE_SPLIT:-}" ]; then
  # Every frame leaves in two writes with a pause between, so the runner
  # reads a partial frame as its own chunk.
  while IFS= read -r frame || [ -n "$frame" ]; do
    printf '%s' "$(printf '%s' "$frame" | cut -c1-20)"
    sleep 0.05
    printf '%s\n' "$(printf '%s' "$frame" | cut -c21-)"
  done < "$stream"
elif [ -n "${BEE_FIXTURE_TRUNCATE:-}" ]; then
  head -n -1 "$stream"
else
  cat "$stream"
fi
if [ -n "$stream_json" ]; then
  # A stream-json session ends when stdin closes, as the real executable's does.
  while IFS= read -r _; do :; done
fi
if [ -n "${BEE_FIXTURE_ORPHAN:-}" ]; then
  # A descendant that outlives the fixture while holding its pipes.
  (sleep "$BEE_FIXTURE_ORPHAN" &)
fi
if [ -n "${BEE_FIXTURE_LINGER:-}" ]; then
  sleep "$BEE_FIXTURE_LINGER"
fi
exit "${BEE_FIXTURE_EXIT:-0}"
