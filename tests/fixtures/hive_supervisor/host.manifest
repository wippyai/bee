# MIT. Minimal host composition for the isolated Hive supervisor proof.
version: '1.0'
namespace: bee
entries:
- name: terminal
  kind: terminal.host
  lifecycle: {auto_start: true, requires: [bee.hive:supervisor_host]}
- name: workers
  kind: process.host
  host: {max_processes: 64, workers: 2}
  lifecycle: {auto_start: true}
- name: dependency_sync
  kind: ns.dependency
  component: bee/sync
  version: 0.1.0-dev
  parameters:
  - name: target_sender
    value: bee.hive.host:replica_sender
  - name: target_exports
    value: bee:sync_exports
- name: sync_exports
  kind: registry.entry
  meta:
    type: bee.sync.exports
  data: {exports: []}
- name: hive_supervisor_policy
  kind: security.policy
  policy:
    actions: [process.send, process.monitor, process.unmonitor]
    resources: '*'
    effect: allow
- name: hive_catalog_policy
  kind: security.policy
  policy:
    actions: [registry.get, registry.find]
    resources: '*'
    effect: allow
- name: hive_exposure_policy
  kind: security.policy
  policy:
    actions: [hive.expose.open]
    resources: [bee.hive.telemetry:presence, bee.hive.telemetry:stats, bee.hive.telemetry:catalog_list]
    effect: allow
- name: hive_policy_exposure_policy
  kind: security.policy
  policy:
    actions: [hive.expose.policy]
    resources: [bee.node.binding:describe, bee.node.binding:update_metadata, bee.node.binding:snapshot, bee.node.binding:read_after,
      bee.approvals.binding:feed_snapshot, bee.approvals.binding:feed_read_after, bee.approvals.binding:read, bee.approvals.binding:decide,
      bee.approvals.binding:withdraw, bee.sync.binding:replica_receive]
    effect: allow
- name: hive_replica_admission_policy
  kind: security.policy
  policy:
    actions: [registry.get, system.read, funcs.call, funcs.security, security.actor.create,
      security.scope.create, security.policy.get, hive.expose.policy]
    resources: '*'
    effect: allow
- name: policy_admission_policy
  kind: security.policy
  policy:
    actions: [registry.get, system.read, funcs.call]
    resources: [node, bee.hive.supervisor:principal_mappings, bee.hive.supervisor:invoke_check,
      bee.node.binding:describe, bee.node.binding:update_metadata, bee.node.binding:snapshot, bee.node.binding:read_after,
      bee.approvals.binding:feed_snapshot, bee.approvals.binding:feed_read_after, bee.approvals.binding:read, bee.approvals.binding:decide,
      bee.approvals.binding:withdraw, bee.sync.binding:replica_receive]
    effect: allow
- name: hive_names_policy
  kind: security.policy
  policy:
    actions: [process.registry.register, process.registry.register.local, process.registry.register.eventual,
      process.registry.lookup, process.registry.unregister, process.registry.unregister.eventual]
    resources: [bee.hive.supervisor, 'bee.hive.supervisor/*']
    effect: allow
- name: hive_advertise_policy
  kind: security.policy
  policy:
    actions: [process.registry.foreign]
    resources: '*'
    effect: allow
- name: hive_dispatch_policy
  kind: security.policy
  policy:
    actions: [funcs.call]
    resources: [bee.hive.telemetry:presence, bee.hive.telemetry:stats, bee.hive.telemetry:catalog_list]
    effect: allow
- name: hive_execute_policy
  kind: security.policy
  policy:
    actions: [funcs.call]
    resources: [bee.hive.supervisor:execute, bee.hive.supervisor:admit_policy, bee.hive.supervisor:advertise]
    effect: allow
- name: hive_invite_policy
  kind: security.policy
  policy:
    actions: [hive.invite]
    resources: [bee.hive.join:invite, bee.hive.join:invites, bee.hive.join:revoke, bee.hive.join:peers, bee.hive.join:redeem]
    effect: allow
- name: hive_telemetry_policy
  kind: security.policy
  policy:
    actions: [system.read]
    resources: [node, cluster, memory, goroutines]
    effect: allow
