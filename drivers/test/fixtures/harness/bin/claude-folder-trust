#!/usr/bin/python3
"""Credential-free interactive Claude fixture with the isolated-home trust gate."""
import json
import os
from pathlib import Path
import sys

if sys.argv[1:2] == ["--version"]:
    print("Claude Code 2.1.296")
    raise SystemExit
if sys.argv[1:2] == ["--help"]:
    print((Path(__file__).resolve().parents[2] / "driver-options/claude-2.1.296-help.txt").read_text())
    raise SystemExit
if sys.argv[1:3] == ["auth", "status"]:
    print('{"loggedIn":true,"authMethod":"fixture"}')
    raise SystemExit

folder = os.getcwd()
home = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path(os.environ["HOME"]) / ".claude")))
home.mkdir(parents=True, exist_ok=True)
config = home / ".claude.json"
document = json.loads(config.read_text()) if config.exists() else {}
if not document.get("projects", {}).get(folder, {}).get("hasTrustDialogAccepted"):
    print("Accessing workspace:\n" + folder
          + "\nQuick safety check: Is this a project you created or one you trust?"
          + "\n1. Yes, I trust this folder\n2. No, exit\nEnter to confirm", flush=True)
    if input() == "2":
        raise SystemExit
    document.setdefault("projects", {}).setdefault(folder, {})["hasTrustDialogAccepted"] = True
    config.write_text(json.dumps(document))
print("CLAUDE FIXTURE READY — folder trust accepted", flush=True)
for line in sys.stdin:
    if line.strip() == "/exit":
        break
    print("Fixture received: " + line.strip(), flush=True)
